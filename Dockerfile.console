FROM golang:1.27 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -o /optipod-console ./cmd/optipod-console

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /optipod-console /optipod-console
USER 65532:65532
ENTRYPOINT ["/optipod-console"]
