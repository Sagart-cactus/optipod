# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Include source directories explicitly: Podman does not descend into
# excluded parent directories for a nested Go-file exception.
!api/
!api/**
!cmd/
!cmd/**
!internal/
!internal/**
# CI builds the metrics fixture from the repository root context.
!test/
!test/e2e/
!test/e2e/metricsfixture/
!test/e2e/metricsfixture/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Embedded console assets and database migrations
!internal/console/schema.sql
!internal/console/ui/**
