{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secret": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "token": {
              "type": "string"
            },
            "identity": {
              "type": "string"
            }
          }
        },
        "identity": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "caSecret": {
          "type": "string"
        },
        "env": {
          "type": "array"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceAccountAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "secret": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "config": {
              "type": "object"
            },
            "databaseURL": {
              "type": "string"
            }
          }
        },
        "agentTLS": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "publicURL": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "secret": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "data": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "env": {
          "type": "array"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        }
      }
    }
  }
}
